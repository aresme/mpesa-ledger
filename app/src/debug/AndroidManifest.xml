<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-build-only components; merged into the debug manifest, absent from release. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          Simulated incoming SMS for testing on a real phone without moving money:
          scripts/sim-sms.sh "<body>". Guarded by DUMP, which the adb shell user holds but
          ordinary apps cannot obtain, so other apps can't inject fake transactions.
        -->
        <receiver
            android:name=".debug.DebugSmsReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.ares.mpesaledger.DEBUG_SMS" />
            </intent-filter>
        </receiver>
        <!-- Debug-only perf test (scripts/perf.sh); demo mode only. -->
        <receiver
            android:name=".debug.PerfReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.ares.mpesaledger.DEBUG_PERF" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
